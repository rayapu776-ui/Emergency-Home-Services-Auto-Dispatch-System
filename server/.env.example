# =================================================================
# Argent Your - Server Environment Configuration Template
# =================================================================

PORT=5000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=argent-your-secret-key-change-in-production

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:3000

# =================================================================
# EMAIL OTP DELIVERY (Nodemailer SMTP Configuration)
# =================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Argent Your Verification" <noreply@argentyour.com>

# =================================================================
# SMS OTP DELIVERY (Twilio Configuration)
# =================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEFAULT_COUNTRY_CODE=+91

# Local development Ethereal test inbox (true/false)
ENABLE_ETHEREAL_DEV=false
